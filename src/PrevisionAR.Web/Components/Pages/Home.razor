@page "/"
@rendermode InteractiveServer
@using PrevisionAR.Motor.Computo
@using PrevisionAR.Motor.Modelo
@using PrevisionAR.Motor.Requisitos

<PageTitle>Previsión AR — Cómputo y requisitos de la PBU</PageTitle>

<h1>Cómputo de servicios y requisitos de la PBU</h1>
<p class="aviso">
    Versión de prueba (fichas R001 y R002, en revisión). Herramienta de apoyo: no reemplaza el criterio profesional.
    Usar datos ficticios.
</p>

<section>
    <h2>Persona</h2>
    <label>
        Fecha de nacimiento:
        <input type="date" @bind="_fechaDeNacimiento" />
    </label>
    <label>
        Sexo (Ley 24.241, art. 19):
        <select @bind="_sexo">
            <option value="@Sexo.Hombre">Hombre</option>
            <option value="@Sexo.Mujer">Mujer</option>
        </select>
    </label>
</section>

<section>
    <h2>Historia laboral</h2>
    <table class="tabla">
        <thead>
            <tr>
                <th>Empleador o actividad</th>
                <th>Desde</th>
                <th>Hasta (vacío = sigue)</th>
                <th>Tipo</th>
                <th>Con aportes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fila in _filas)
            {
                <tr>
                    <td><input @bind="fila.Empleador" /></td>
                    <td><input type="date" @bind="fila.Desde" /></td>
                    <td><input type="date" @bind="fila.Hasta" /></td>
                    <td>
                        <select @bind="fila.Tipo">
                            <option value="@TipoDeServicio.RelacionDeDependencia">Relación de dependencia</option>
                            <option value="@TipoDeServicio.Autonomo">Autónomo</option>
                        </select>
                    </td>
                    <td><input type="checkbox" @bind="fila.ConAportes" /></td>
                    <td><button type="button" @onclick="() => Quitar(fila)">Quitar</button></td>
                </tr>
            }
        </tbody>
    </table>
    <button type="button" @onclick="Agregar">Agregar período</button>
    <button type="button" @onclick="CargarEjemplo">Cargar ejemplo</button>
</section>

<section>
    <h2>Cálculo</h2>
    <label>
        Fecha de cálculo (solicitud):
        <input type="date" @bind="_fechaDeCalculo" />
    </label>
    <button type="button" class="principal" @onclick="Calcular">Calcular</button>
</section>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

@if (_requisitos is not null)
{
    <section>
        <h2>Requisitos de la PBU (R002)</h2>
        <p class="@(_requisitos.TieneDerecho ? "veredicto si" : "veredicto no")">
            @(_requisitos.TieneDerecho ? "Cumple los requisitos de la PBU." : "No cumple los requisitos de la PBU.")
        </p>
        <ol>
            @foreach (var paso in _requisitos.Explicacion)
            {
                <li>@paso</li>
            }
        </ol>
    </section>
}

@if (_resultado is not null)
{
    <section>
        <h2>Cómputo de servicios (R001)</h2>
        <p class="total">
            Total de servicios con aportes: <strong>@_resultado.Total</strong>
            (@_resultado.Total.TotalMeses meses · @_resultado.Total.DiasCalendario días calendario)
        </p>
        <p>Calculado al @_resultado.FechaDeCalculo.ToString("dd/MM/yyyy") con la regla <strong>@_resultado.Regla</strong>.</p>

        <h3>Desglose por tramo y tipo</h3>
        <table class="tabla">
            <thead>
                <tr>
                    <th>Tramo</th>
                    <th>Total</th>
                    <th>Solo dependencia (n)</th>
                    <th>Solo autónomo (m)</th>
                    <th>Simultáneo (p)</th>
                </tr>
            </thead>
            <tbody>
                <FilaDesglose Nombre="Hasta 30/06/1994 (PC)" Desglose="_resultado.HastaJunio1994" />
                <FilaDesglose Nombre="Desde 01/07/1994 (PAP)" Desglose="_resultado.DesdeJulio1994" />
            </tbody>
        </table>

        <h3>Superposiciones (contadas una sola vez)</h3>
        @if (_resultado.Superposiciones.Count == 0)
        {
            <p>No hay.</p>
        }
        else
        {
            <ul>
                @foreach (var s in _resultado.Superposiciones)
                {
                    <li>@s.PeriodoA y @s.PeriodoB: del @s.Desde.ToString("dd/MM/yyyy") al @s.Hasta.ToString("dd/MM/yyyy") (@s.DiasCalendario días)</li>
                }
            </ul>
        }

        <h3>Períodos no computados</h3>
        @if (_resultado.NoComputados.Count == 0)
        {
            <p>Ninguno.</p>
        }
        else
        {
            <ul>
                @foreach (var n in _resultado.NoComputados)
                {
                    <li>@n.Periodo.Empleador: @DescribirMotivo(n.Motivo)</li>
                }
            </ul>
        }
    </section>
}

@code {
    private readonly List<FilaPeriodo> _filas = [new FilaPeriodo()];
    private DateOnly _fechaDeCalculo = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly _fechaDeNacimiento = new(1960, 1, 1);
    private Sexo _sexo = Sexo.Hombre;
    private ResultadoDelComputo? _resultado;
    private ResultadoRequisitosPbu? _requisitos;
    private string? _error;

    private void Agregar() => _filas.Add(new FilaPeriodo());

    private void Quitar(FilaPeriodo fila) => _filas.Remove(fila);

    private void CargarEjemplo()
    {
        _filas.Clear();
        _filas.Add(new FilaPeriodo { Empleador = "Empresa A (ficticia)", Desde = new(1990, 1, 1), Hasta = new(2009, 12, 31) });
        _filas.Add(new FilaPeriodo { Empleador = "Actividad autónoma (ficticia)", Desde = new(2005, 1, 1), Hasta = new(2014, 12, 31), Tipo = TipoDeServicio.Autonomo });
        _filas.Add(new FilaPeriodo { Empleador = "Empresa B sin aportes (ficticia)", Desde = new(2015, 1, 1), Hasta = new(2016, 6, 30), ConAportes = false });
        _fechaDeCalculo = new DateOnly(2026, 1, 1);
        _fechaDeNacimiento = new DateOnly(1958, 4, 15);
        _sexo = Sexo.Hombre;
        _resultado = null;
        _requisitos = null;
        _error = null;
    }

    private void Calcular()
    {
        _error = null;
        _resultado = null;
        _requisitos = null;
        try
        {
            var historia = new HistoriaLaboral(_filas.Select(f => f.APeriodo()).ToList());
            _requisitos = RequisitosPbu.Verificar(new Persona(_fechaDeNacimiento, _sexo), historia, _fechaDeCalculo);
            _resultado = _requisitos.ComputoDeServicios;
        }
        catch (HistoriaLaboralInvalidaException ex)
        {
            _error = ex.Message;
        }
        catch (DatosPersonalesInvalidosException ex)
        {
            _error = ex.Message;
        }
    }

    private static string DescribirMotivo(MotivoNoComputado motivo) => motivo switch
    {
        MotivoNoComputado.SinAportes => "sin aportes",
        MotivoNoComputado.PosteriorALaFechaDeCalculo => "empieza después de la fecha de cálculo",
        _ => motivo.ToString(),
    };

    /// <summary>Fila editable de la tabla. Solo traslada datos al motor; no calcula nada.</summary>
    private sealed class FilaPeriodo
    {
        public string Empleador { get; set; } = string.Empty;
        public DateOnly Desde { get; set; } = new(2000, 1, 1);
        public DateOnly? Hasta { get; set; }
        public TipoDeServicio Tipo { get; set; } = TipoDeServicio.RelacionDeDependencia;
        public bool ConAportes { get; set; } = true;

        public PeriodoDeServicio APeriodo() =>
            new(string.IsNullOrWhiteSpace(Empleador) ? "(sin nombre)" : Empleador.Trim(), Desde, Hasta, Tipo, ConAportes);
    }
}
