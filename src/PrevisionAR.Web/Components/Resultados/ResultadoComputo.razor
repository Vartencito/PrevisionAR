@using PrevisionAR.Motor.Computo

@* Muestra el resultado de R001 tal como lo devuelve el motor. No calcula nada. *@
<section>
    <h2>Cómputo de servicios (@Resultado.Regla)</h2>
    <p class="total">
        Total de servicios con aportes: <strong>@Resultado.Total</strong>
        (@Resultado.Total.TotalMeses meses · @Resultado.Total.DiasCalendario días calendario)
    </p>
    <p>Calculado al @Fecha(Resultado.FechaDeCalculo).</p>

    <h3>Desglose por tramo y tipo</h3>
    <table class="tabla">
        <thead>
            <tr>
                <th>Tramo</th>
                <th>Total</th>
                <th>Solo dependencia (n)</th>
                <th>Solo autónomo (m)</th>
                <th>Simultáneo (p)</th>
            </tr>
        </thead>
        <tbody>
            <FilaDesglose Nombre="@($"Hasta {Fecha(ComputoDeServicios.CorteDeTramos.AddDays(-1))} (PC)")" Desglose="Resultado.HastaJunio1994" />
            <FilaDesglose Nombre="@($"Desde {Fecha(ComputoDeServicios.CorteDeTramos)} (PAP)")" Desglose="Resultado.DesdeJulio1994" />
        </tbody>
    </table>

    <h3>Superposiciones (contadas una sola vez)</h3>
    @if (Resultado.Superposiciones.Count == 0)
    {
        <p>No hay.</p>
    }
    else
    {
        <ul>
            @foreach (var s in Resultado.Superposiciones)
            {
                <li>@s.PeriodoA.Empleador y @s.PeriodoB.Empleador: del @Fecha(s.Desde) al @Fecha(s.Hasta) (@s.DiasCalendario días)</li>
            }
        </ul>
    }

    <h3>Períodos no computados</h3>
    @if (Resultado.NoComputados.Count == 0)
    {
        <p>Ninguno.</p>
    }
    else
    {
        <ul>
            @foreach (var n in Resultado.NoComputados)
            {
                <li>@n.Periodo.Empleador: @DescribirMotivo(n.Motivo)</li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public ResultadoDelComputo Resultado { get; set; } = default!;

    private static string Fecha(DateOnly fecha) => Formato.Fecha(fecha);

    private static string DescribirMotivo(MotivoNoComputado motivo) => motivo switch
    {
        MotivoNoComputado.SinAportes => "sin aportes",
        MotivoNoComputado.PosteriorALaFechaDeCalculo => "empieza después de la fecha de cálculo",
        _ => motivo.ToString(),
    };
}
